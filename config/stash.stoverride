# Stash 覆写文件（.stoverride）
#
# 由 tools/build-stash.py 生成，请勿手改。
# 规则数据与 Shadowrocket 配置共用 rule/*.list，两边分开维护各自的配置。
#
# 这是覆写而非完整配置：节点来自你自己的订阅，覆写只替换规则与分组，
# 不碰节点，所以仓库里不需要出现订阅地址。
#
# 用法：Stash -> 配置 -> 覆写 -> 添加，填入本文件的 raw 地址，
# 然后在订阅配置上启用该覆写。

name: Shadowrocket 全量配置 (Stash)
desc: 与 Shadowrocket 配置共用规则数据。含协议分组、地区分组、线路属性分组。
author: adrianyusong
homepage: https://github.com/adrianyusong/shadowrocket
category: rules

# 用 #!replace 整段替换订阅自带的 dns，避免与机场配置相互干扰。
dns: #!replace
  enable: true
  ipv6: false
  # fake-ip 让域名不必真正解析就能进规则匹配，是避免 DNS 泄漏的关键。
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  # 这些必须拿到真实 IP，走 fake-ip 会坏：局域网发现、游戏机 STUN、
  # 系统联网检测。
  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - "+.srv.nintendo.net"
    - "+.stun.playstation.net"
    - "+.msftconnecttest.com"
    - "+.msftncsi.com"
    - "localhost.ptlogin2.qq.com"
    - "+.battle.net"
    - "stun.*"
    - "time.*.com"
    - "ntp.*.com"
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  # 直连域名用国内 DoH 解析；明文 UDP 53 本身可被中间人劫持。
  nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  # 解析节点域名时用的 DNS。走这里可避免「解析节点地址」这一步本身被污染。
  proxy-server-nameserver:
    - https://dns.alidns.com/dns-query
  # 代理域名交给远端解析，不在本地留痕。
  nameserver-policy:
    "geosite:cn":
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query

# HTTP 引擎。本覆写自身只做一条重写，iRingo 等覆写各自带 mitm 与 script，
# 叠加时会合并，不需要在此手抄它们的域名。
http:
  # 重写要生效必须同时满足：域名在 mitm 列表里 + 证书已安装并信任。
  # 只列本覆写自己需要解密的域名，列表越小性能与风险越低。
  mitm:
    - "g.cn"
    - "*.g.cn"
    - "www.google.cn"
    - "*.google.cn"
  # google.cn / g.cn 是 Google 中国的旧域名，2010 年退出后只剩跳转落地页。
  # 重写成 www.google.com，让旧书签、二维码、App 内链接直接落到真正的 Google。
  url-rewrite:
    - ^https?://(www\.)?g\.cn https://www.google.com 302
    - ^https?://(www\.)?google\.cn https://www.google.com 302

# 分组用 #!replace 整段替换，否则会与订阅自带的分组混在一起。
proxy-groups: #!replace
  # 主策略。候选里同时给出协议、线路属性、地区三个维度，按需切换。
  - name: "🚀 节点选择"
    type: select
    proxies:
      - "♻️ 自动选择"
      - "🔯 故障转移"
      - "🔮 负载均衡"
      - "🔧 手动选择"
      - "🅥 VLESS"
      - "🅗 Hysteria2"
      - "🅣 Trojan"
      - "🅢 Shadowsocks"
      - "🏠 住宅IP"
      - "🛣️ 专线"
      - "🎞️ 流媒体节点"
      - "💴 低倍率"
      - "🇭🇰 香港"
      - "🇹🇼 台湾"
      - "🇯🇵 日本"
      - "🇸🇬 狮城"
      - "🇺🇲 美国"
      - "🇰🇷 韩国"
      - "DIRECT"
  # 自动测速类。filter 排除机场的信息类伪节点。
  # include-all 不可省：filter / exclude-type 只对 use 引入的 provider 或
  # include-all 之后的全体节点生效，两者都没有时组内无节点可筛，会是空组。
  - name: "♻️ 自动选择"
    type: url-test
    include-all: true
    filter: "(?i)^(?!.*(官网|官方|网站|網站|客服|邀请|邀請|重置|剩余|剩餘|到期|过期|過期|流量|套餐|订阅|訂閱|群组|群組|直连|直連|Expire|Traffic|Reset|Website)).*$"
    url: "http://www.gstatic.com/generate_204"
    interval: 300
    tolerance: 100
    lazy: true
  - name: "🔯 故障转移"
    type: fallback
    include-all: true
    filter: "(?i)^(?!.*(官网|官方|网站|網站|客服|邀请|邀請|重置|剩余|剩餘|到期|过期|過期|流量|套餐|订阅|訂閱|群组|群組|直连|直連|Expire|Traffic|Reset|Website)).*$"
    url: "http://www.gstatic.com/generate_204"
    interval: 300
    lazy: true
  - name: "🔮 负载均衡"
    type: load-balance
    include-all: true
    filter: "(?i)^(?!.*(官网|官方|网站|網站|客服|邀请|邀請|重置|剩余|剩餘|到期|过期|過期|流量|套餐|订阅|訂閱|群组|群組|直连|直連|Expire|Traffic|Reset|Website)).*$"
    url: "http://www.gstatic.com/generate_204"
    interval: 300
    strategy: consistent-hashing
  # 手动挑单个节点用。上面几组都是自动的，没有这一组就只能选组不能选节点。
  - name: "🔧 手动选择"
    type: select
    include-all: true
    filter: "(?i)^(?!.*(官网|官方|网站|網站|客服|邀请|邀請|重置|剩余|剩餘|到期|过期|過期|流量|套餐|订阅|訂閱|群组|群組|直连|直連|Expire|Traffic|Reset|Website)).*$"
  # 协议分组。proxy-groups 只有 exclude-type 没有 include-type，
  # 所以「只要某协议」写成「排除其余全部」。这是 Shadowrocket 做不到的维度。
  - name: "🅥 VLESS"
    type: url-test
    include-all: true
    exclude-type: "ss|ssr|vmess|trojan|hysteria|hysteria2|tuic|wireguard|snell|http|socks5|anytls|ssh"
    url: "http://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "🅗 Hysteria2"
    type: url-test
    include-all: true
    exclude-type: "ss|ssr|vmess|vless|trojan|tuic|wireguard|snell|http|socks5|anytls|ssh"
    url: "http://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "🅣 Trojan"
    type: url-test
    include-all: true
    exclude-type: "ss|ssr|vmess|vless|hysteria|hysteria2|tuic|wireguard|snell|http|socks5|anytls|ssh"
    url: "http://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "🅢 Shadowsocks"
    type: url-test
    include-all: true
    exclude-type: "vmess|vless|trojan|hysteria|hysteria2|tuic|wireguard|snell|http|socks5|anytls|ssh"
    url: "http://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  # 线路属性分组，与地区维度正交。
  - name: "🏠 住宅IP"
    type: url-test
    include-all: true
    filter: "(?i)(住宅|家宽|家寬|原生|Residential)"
    url: "http://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "🛣️ 专线"
    type: url-test
    include-all: true
    filter: "(?i)(专线|專線|IPLC|IEPL)"
    url: "http://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "🎞️ 流媒体节点"
    type: url-test
    include-all: true
    filter: "(?i)(流媒体|流媒體)"
    url: "http://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "💴 低倍率"
    type: url-test
    include-all: true
    filter: "(?i)(?<![0-9.])0\\.[0-9]+ ?x"
    url: "http://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  # 地区分组。
  - name: "🇭🇰 香港"
    type: url-test
    include-all: true
    filter: "(?i)(香港|港岛|深港|沪港|Hong ?Kong|(?<![A-Za-z])(HK|HKG)(?![A-Za-z]))"
    url: "http://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "🇹🇼 台湾"
    type: url-test
    include-all: true
    filter: "(?i)(台湾|台灣|台北|臺灣|Taiwan|(?<![A-Za-z])(TW|TPE)(?![A-Za-z]))"
    url: "http://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "🇯🇵 日本"
    type: url-test
    include-all: true
    filter: "(?i)(日本|東京|东京|大阪|名古屋|埼玉|Japan|(?<![A-Za-z])(JP|JPN|NRT|KIX)(?![A-Za-z]))"
    url: "http://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "🇸🇬 狮城"
    type: url-test
    include-all: true
    filter: "(?i)(新加坡|狮城|獅城|Singapore|(?<![A-Za-z])(SG|SIN)(?![A-Za-z]))"
    url: "http://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "🇺🇲 美国"
    type: url-test
    include-all: true
    filter: "(?i)(美国|美國|美西|美东|美東|洛杉矶|圣何塞|西雅图|达拉斯|凤凰城|United ?States|(?<![A-Za-z])(US|USA|LAX|SJC)(?![A-Za-z]))"
    url: "http://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "🇰🇷 韩国"
    type: url-test
    include-all: true
    filter: "(?i)(韩国|韓國|首尔|首爾|Korea|(?<![A-Za-z])(KR|ICN)(?![A-Za-z]))"
    url: "http://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  # AI 对 IP 风控极严。住宅 IP 排首位——机房 IP 是判定代理的首要特征。
  # 候选里刻意不放 🚀 节点选择，避免间接落到负载均衡上每请求换出口。
  - name: "🤖 AI 服务"
    type: select
    proxies:
      - "🏠 住宅IP"
      - "🛣️ 专线"
      - "🇺🇲 美国"
      - "🇯🇵 日本"
      - "🇸🇬 狮城"
      - "DIRECT"
  # 流媒体对 IP 跳变敏感，机场自标的流媒体节点排首位。
  - name: "📹 YOUTUBE"
    type: select
    proxies:
      - "🎞️ 流媒体节点"
      - "🏠 住宅IP"
      - "🇸🇬 狮城"
      - "🇭🇰 香港"
      - "🇯🇵 日本"
      - "🇺🇲 美国"
      - "🚀 节点选择"
      - "DIRECT"
  - name: "🎥 NETFLIX"
    type: select
    proxies:
      - "🎞️ 流媒体节点"
      - "🏠 住宅IP"
      - "🇸🇬 狮城"
      - "🇭🇰 香港"
      - "🇯🇵 日本"
      - "🇺🇲 美国"
      - "🚀 节点选择"
      - "DIRECT"
  - name: "🎬 DISNEY+"
    type: select
    proxies:
      - "🎞️ 流媒体节点"
      - "🏠 住宅IP"
      - "🇸🇬 狮城"
      - "🇭🇰 香港"
      - "🇯🇵 日本"
      - "🇺🇲 美国"
      - "🚀 节点选择"
      - "DIRECT"
  - name: "🎦 HBO"
    type: select
    proxies:
      - "🎞️ 流媒体节点"
      - "🏠 住宅IP"
      - "🇸🇬 狮城"
      - "🇭🇰 香港"
      - "🇯🇵 日本"
      - "🇺🇲 美国"
      - "🚀 节点选择"
      - "DIRECT"
  - name: "📦 PRIMEVIDEO"
    type: select
    proxies:
      - "🎞️ 流媒体节点"
      - "🏠 住宅IP"
      - "🇸🇬 狮城"
      - "🇭🇰 香港"
      - "🇯🇵 日本"
      - "🇺🇲 美国"
      - "🚀 节点选择"
      - "DIRECT"
  - name: "🎧 SPOTIFY"
    type: select
    proxies:
      - "🚀 节点选择"
      - "♻️ 自动选择"
      - "DIRECT"
  - name: "🎶 TIKTOK"
    type: select
    proxies:
      - "🚀 节点选择"
      - "♻️ 自动选择"
      - "DIRECT"
  - name: "🎙️ TWITCH"
    type: select
    proxies:
      - "🚀 节点选择"
      - "♻️ 自动选择"
      - "DIRECT"
  - name: "☁️ PIKPAK"
    type: select
    proxies:
      - "🚀 节点选择"
      - "♻️ 自动选择"
      - "DIRECT"
  - name: "🌍 国外媒体"
    type: select
    proxies:
      - "🚀 节点选择"
      - "♻️ 自动选择"
      - "DIRECT"
  - name: "📲 TELEGRAM"
    type: select
    proxies:
      - "🚀 节点选择"
      - "♻️ 自动选择"
      - "DIRECT"
  - name: "🐦 TWITTER"
    type: select
    proxies:
      - "🚀 节点选择"
      - "♻️ 自动选择"
      - "DIRECT"
  - name: "📘 META"
    type: select
    proxies:
      - "🚀 节点选择"
      - "♻️ 自动选择"
      - "DIRECT"
  - name: "💬 DISCORD"
    type: select
    proxies:
      - "🚀 节点选择"
      - "♻️ 自动选择"
      - "DIRECT"
  - name: "🐱 GITHUB"
    type: select
    proxies:
      - "🚀 节点选择"
      - "♻️ 自动选择"
      - "DIRECT"
  - name: "🔍 BING"
    type: select
    proxies:
      - "🚀 节点选择"
      - "♻️ 自动选择"
      - "DIRECT"
  - name: "📢 谷歌服务"
    type: select
    proxies:
      - "🚀 节点选择"
      - "♻️ 自动选择"
      - "DIRECT"
  - name: "🎵 苹果媒体"
    type: select
    proxies:
      - "🚀 节点选择"
      - "♻️ 自动选择"
      - "DIRECT"
  - name: "🕹️ 巴哈姆特"
    type: select
    proxies:
      - "🇹🇼 台湾"
      - "🚀 节点选择"
