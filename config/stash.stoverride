# 规则顺序与 Shadowrocket 配置一致，几处刻意安排见 README。
rules: #!replace
  # 高频埋点用 REJECT-DROP：静默丢包让 App 等超时才重试，
  # 日志实测 rmonitor.qq.com 从 1592 次/小时降到 9 次/小时。
  - DOMAIN,rmonitor.qq.com,REJECT-DROP
  - DOMAIN,h.trace.qq.com,REJECT-DROP
  - DOMAIN-SUFFIX,jpush.cn,REJECT-DROP
  - DOMAIN-SUFFIX,jpush.io,REJECT-DROP
  - DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT-DROP
  - DOMAIN-SUFFIX,pangle.io,REJECT-DROP
  - DOMAIN-SUFFIX,iadsdk.apple.com,REJECT-DROP
  # LinkedIn 中国 2023 年停运，国内 DNS 仍会把 linkedin.com 解析到国内 IP，
  # 不显式指定就会被后面的 GEOIP,CN 判成国内服务走直连。
  - DOMAIN-SUFFIX,linkedin.com,🚀 节点选择
  - DOMAIN-SUFFIX,licdn.com,🚀 节点选择
  - DOMAIN-SUFFIX,linkedin-ei.com,🚀 节点选择
  - DOMAIN-SUFFIX,linkedin.cn,🚀 节点选择
  - DOMAIN-SUFFIX,licdn.cn,🚀 节点选择
  # 境外 AI 服务，上游规则集未覆盖。
  - DOMAIN-SUFFIX,poe.com,🤖 AI 服务
  - DOMAIN-SUFFIX,huggingface.co,🤖 AI 服务
  - DOMAIN-SUFFIX,hf.co,🤖 AI 服务
  - DOMAIN-SUFFIX,cursor.sh,🤖 AI 服务
  - DOMAIN-SUFFIX,cursor.com,🤖 AI 服务
  - DOMAIN-SUFFIX,midjourney.com,🤖 AI 服务
  # 游戏本体下载走直连，否则几十 GB 烧机场套餐。
  - DOMAIN-SUFFIX,steampipe.akamaized.net,🎯 全球直连
  - DOMAIN-SUFFIX,steampipe-kr.akamaized.net,🎯 全球直连
  - DOMAIN-SUFFIX,steampipe-partner.akamaized.net,🎯 全球直连
  - DOMAIN-SUFFIX,steamcdn-a.akamaihd.net,🎯 全球直连
  - DOMAIN-SUFFIX,steamusercontent-a.akamaihd.net,🎯 全球直连
  - DOMAIN-SUFFIX,steamcontent.tnkjmec.com,🎯 全球直连
  - DOMAIN-SUFFIX,blzddist1-a.akamaihd.net,🎯 全球直连
  - DOMAIN-SUFFIX,blzddistkr1-a.akamaihd.net,🎯 全球直连
  - DOMAIN-SUFFIX,blzmedia-a.akamaihd.net,🎯 全球直连
  - DOMAIN-SUFFIX,blznav.akamaized.net,🎯 全球直连
  - DOMAIN-SUFFIX,blizzcon-a.akamaihd.net,🎯 全球直连
  - DOMAIN-SUFFIX,blz-contentstack.com,🎯 全球直连
  - DOMAIN-SUFFIX,eac-cdn.com,🎯 全球直连
  # 拼多多与 .cn 顶级域。
  - DOMAIN-SUFFIX,pinduoduo.com,🇨🇳 国内服务
  - DOMAIN-SUFFIX,pinduoduo.net,🇨🇳 国内服务
  - DOMAIN-SUFFIX,pddpic.com,🇨🇳 国内服务
  - DOMAIN-SUFFIX,yangkeduo.com,🇨🇳 国内服务
  - DOMAIN-SUFFIX,cn,🇨🇳 国内服务
  # 全部 Apple 流量走代理。
  - DOMAIN-SUFFIX,apple.com,🍎 苹果服务
  - DOMAIN-SUFFIX,apple.news,🍎 苹果服务
  - DOMAIN-SUFFIX,aaplimg.com,🍎 苹果服务
  - DOMAIN-SUFFIX,icloud.com,🍎 苹果服务
  - DOMAIN-SUFFIX,icloud-content.com,🍎 苹果服务
  - DOMAIN-SUFFIX,cdn-apple.com,🍎 苹果服务
  - DOMAIN-SUFFIX,mzstatic.com,🍎 苹果服务
  - DOMAIN-SUFFIX,apple-cloudkit.com,🍎 苹果服务
  - DOMAIN-SUFFIX,apple-mapkit.com,🍎 苹果服务
  - DOMAIN-SUFFIX,itunes.com,🍎 苹果服务
  - DOMAIN-SUFFIX,me.com,🍎 苹果服务
  - IP-CIDR,17.0.0.0/8,🍎 苹果服务,no-resolve

  # 规则集
  - RULE-SET,direct-domain,DIRECT
  - RULE-SET,direct-ipcidr,DIRECT,no-resolve
  - RULE-SET,reject-ads-domain,🛑 广告拦截
  - RULE-SET,reject-ads-ipcidr,🛑 广告拦截,no-resolve
  - RULE-SET,reject-ads-classical,🛑 广告拦截
  - RULE-SET,reject-privacy-ipcidr,🍃 应用净化,no-resolve
