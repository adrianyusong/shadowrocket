      - "🚀 节点选择"
      - "DIRECT"
  # 以下默认直连。
  - name: "Ⓜ️ 微软服务"
    type: select
    proxies:
      - "DIRECT"
      - "🚀 节点选择"
  - name: "💰 支付服务"
    type: select
    proxies:
      - "DIRECT"
      - "🚀 节点选择"
  - name: "🌏 国内媒体"
    type: select
    proxies:
      - "DIRECT"
      - "🚀 节点选择"
  - name: "📀 EMBY"
    type: select
