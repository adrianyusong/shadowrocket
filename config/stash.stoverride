  - name: "🐟 漏网之鱼"
    type: select
    proxies:
      - "🚀 节点选择"
      - "DIRECT"
      - "♻️ 自动选择"

# 规则集。domain 与 ipcidr 是为海量规则优化的加载器，classical 效率最低，
# 所以按类型拆开而不是整份丢给 classical。
rule-providers: #!replace
  direct-domain:
    type: http
    behavior: domain
    format: text
    url: https://raw.githubusercontent.com/adrianyusong/shadowrocket/main/stash/direct-domain.txt
    path: ./ruleset/direct-domain.txt
    interval: 86400
  direct-ipcidr:
    type: http
    behavior: ipcidr
    format: text
    url: https://raw.githubusercontent.com/adrianyusong/shadowrocket/main/stash/direct-ipcidr.txt
    path: ./ruleset/direct-ipcidr.txt
    interval: 86400
  reject-ads-domain:
    type: http
    behavior: domain
    format: text
    url: https://raw.githubusercontent.com/adrianyusong/shadowrocket/main/stash/reject-ads-domain.txt
    path: ./ruleset/reject-ads-domain.txt
    interval: 86400
  reject-ads-ipcidr:
    type: http
    behavior: ipcidr
    format: text
    url: https://raw.githubusercontent.com/adrianyusong/shadowrocket/main/stash/reject-ads-ipcidr.txt
    path: ./ruleset/reject-ads-ipcidr.txt
    interval: 86400
  reject-ads-classical:
    type: http
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/adrianyusong/shadowrocket/main/stash/reject-ads-classical.txt
    path: ./ruleset/reject-ads-classical.txt
    interval: 86400
  reject-privacy-ipcidr:
    type: http
    behavior: ipcidr
    format: text
    url: https://raw.githubusercontent.com/adrianyusong/shadowrocket/main/stash/reject-privacy-ipcidr.txt
    path: ./ruleset/reject-privacy-ipcidr.txt
    interval: 86400
  reject-privacy-classical:
    type: http
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/adrianyusong/shadowrocket/main/stash/reject-privacy-classical.txt
    path: ./ruleset/reject-privacy-classical.txt
    interval: 86400
  apple-domain:
    type: http
    behavior: domain
    format: text
    url: https://raw.githubusercontent.com/adrianyusong/shadowrocket/main/stash/apple-domain.txt
    path: ./ruleset/apple-domain.txt
    interval: 86400
  apple-ipcidr:
    type: http
    behavior: ipcidr
    format: text
    url: https://raw.githubusercontent.com/adrianyusong/shadowrocket/main/stash/apple-ipcidr.txt
    path: ./ruleset/apple-ipcidr.txt
    interval: 86400
  apple-classical:
    type: http
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/adrianyusong/shadowrocket/main/stash/apple-classical.txt
    path: ./ruleset/apple-classical.txt
    interval: 86400
  apple-media-domain:
    type: http
    behavior: domain
