# Stash 覆写文件（.stoverride）
#
# 由 tools/build-stash.py 生成，请勿手改。
# 规则数据与 Shadowrocket 配置共用 rule/*.list，两边分开维护各自的配置。
#
# 这是覆写而非完整配置：节点来自你自己的订阅，覆写只替换规则与分组，
# 不碰节点，所以仓库里不需要出现订阅地址。
#
# 用法：Stash -> 配置 -> 覆写 -> 添加，填入本文件的 raw 地址，
# 然后在订阅配置上启用该覆写。

name: Shadowrocket 全量配置 (Stash)
desc: 规则与分组候选由 default.conf 推导，与 Shadowrocket 一致。含地区、直连线路、线路属性分组。
author: adrianyusong
homepage: https://github.com/adrianyusong/shadowrocket
category: rules

# 用 #!replace 整段替换订阅自带的 dns，避免与机场配置相互干扰。
dns: #!replace
  enable: true
  ipv6: false
  # fake-ip 让域名不必真正解析就能进规则匹配，是避免 DNS 泄漏的关键。
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  # 收录原则：只放【走直连 + 需要真实 IP】的域名。
  # 走代理的域名不放——对它们 fake-ip 恰恰是优点（免本地解析、免污染）。
  # 需要真实 IP 的三类：局域网/内网发现、NTP 校时、
  # 以及靠出口 IP 判定版权区域的国内音乐服务。
  # 常见配置里的 battle.net / srv.nintendo.net / pvp.net 一类不收：
  # 本配置把游戏平台整体送去代理，对代理域名 fake-ip 才是正解，
  # 放进来只会白白多一次本地解析并泄漏域名。check-config.py 会拦。
  fake-ip-filter:
  # 保留域与局域网
    - "*.lan"
    - "*.local"
    - "*.localdomain"
    - "*.home.arpa"
    - "*.invalid"
    - "*.localhost"
    - "*.test"
    - "*.example"
  # 路由器 / 智能家居管理页，域名指向局域网网关地址
    - "*.router.asus.com"
    - "*.linksys.com"
    - "*.linksyssmartwifi.com"
    - "heartbeat.belkin.com"
  # 系统联网检测：拿到假 IP 会被判成「网络受限」，反复弹强制门户
    - "+.msftconnecttest.com"
    - "+.msftncsi.com"
    - "+.ipv6.microsoft.com"
    - "localhost.ptlogin2.qq.com"
    - "localhost.sec.qq.com"
  # NTP 校时走 UDP 123。假 IP 对不上时间，会连锁导致 TLS 证书校验失败。
  # 只列具体的直连校时主机。之前用 time.*.com / ntp*.*.com 这类泛通配，
  # 会命中走代理的域名（例如 time.apple.com 曾随 Apple 走代理），违反上面的
  # 收录原则，而 check-config 的 check_fakeip 跳过带内部通配的条目，从没查到。
    - "time.apple.com"
    - "time-ios.apple.com"
    - "time-macos.apple.com"
    - "time.asia.apple.com"
    - "time.euro.apple.com"
    - "time.windows.com"
    - "ntp.aliyun.com"
    - "ntp1.aliyun.com"
    - "ntp2.aliyun.com"
    - "ntp3.aliyun.com"
    - "ntp4.aliyun.com"
    - "ntp5.aliyun.com"
    - "ntp6.aliyun.com"
    - "ntp7.aliyun.com"
    - "ntp.tencent.com"
    - "ntp1.tencent.com"
    - "ntp2.tencent.com"
    - "ntp3.tencent.com"
    - "ntp4.tencent.com"
    - "ntp5.tencent.com"
    - "time1.cloud.tencent.com"
    - "time2.cloud.tencent.com"
    - "time3.cloud.tencent.com"
    - "time4.cloud.tencent.com"
    - "time5.cloud.tencent.com"
    - "*.time.edu.cn"
    - "*.ntp.org.cn"
    - "+.pool.ntp.org"
  # STUN 泛通配（stun.* 等）已去掉：stun.l.google.com 这类走代理，与收录原则
  # 冲突；而 P2P 打洞在 Shadowrocket 侧本就被 stun-response-ip 伪造响应挡掉了。
  # 国内音乐：版权区域按出口 IP 判定，假 IP 会被判成海外 -> 大量歌曲变灰
    - "music.163.com"
    - "*.music.163.com"
    - "*.126.net"
    - "y.qq.com"
    - "*.y.qq.com"
    - "aqqmusic.tc.qq.com"
    - "amobile.music.tc.qq.com"
    - "streamoc.music.tc.qq.com"
    - "mobileoc.music.tc.qq.com"
    - "isure.stream.qqmusic.qq.com"
    - "dl.stream.qqmusic.qq.com"
    - "songsearch.kugou.com"
    - "trackercdn.kugou.com"
    - "*.kuwo.cn"
    - "music.migu.cn"
    - "*.music.migu.cn"
    - "music.taihe.com"
    - "musicapi.taihe.com"
  # B 站 PCDN 要真实 IP 做点对点回源
    - "*.mcdn.bilivideo.cn"
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  # 直连域名用国内 DoH 解析；明文 UDP 53 本身可被中间人劫持。
  nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  # 解析节点域名时用的 DNS。走这里可避免「解析节点地址」这一步本身被污染。
  proxy-server-nameserver:
    - https://dns.alidns.com/dns-query
  # 代理域名交给远端解析，不在本地留痕。
  nameserver-policy:
    "geosite:cn":
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query

# HTTP 引擎。本覆写自身只做 google.cn 系列重写，iRingo 等覆写各自带 mitm 与 script，
# 叠加时会合并，不需要在此手抄它们的域名。
http:
  # 重写要生效必须同时满足：域名在 mitm 列表里 + 证书已安装并信任。
  # 只列本覆写自己需要解密的域名，列表越小性能与风险越低。
  mitm:
    - "g.cn"
    - "*.g.cn"
    - "www.google.cn"
    - "*.google.cn"
  # google.cn / g.cn 是 Google 中国的旧域名，2010 年退出后只剩跳转落地页。
  # 重写成 www.google.com，让旧书签、二维码、App 内链接直接落到真正的 Google。
  url-rewrite:
    - ^https?://(www\.)?g\.cn https://www.google.com 302
    - ^https?://(www\.)?google\.cn https://www.google.com 302
  # 地图子域单独指到 Google 地图，落到 google.com 首页等于丢掉用户意图。
    - ^https?://(ditu|maps)\.google\.cn https://maps.google.com 302

# 分组用 #!replace 整段替换，否则会与订阅自带的分组混在一起。
proxy-groups: #!replace
  # 自动测速类。filter 排除机场的信息类伪节点与自建 CF 节点。
  - name: "♻️ 自动选择"
    type: url-test
    include-all: true
    filter: "(?i)^(?!.*(官网|官方|网站|網站|客服|邀请|邀請|重置|剩余|剩餘|到期|过期|過期|流量|套餐|订阅|訂閱|续费|續費|客户端|客戶端|🇦🇶|群组|群組|直连|直連|Expire|Traffic|Reset|Website|(?<![A-Za-z])CF(?![A-Za-z])|Cloudflare)).*$"
    url: "https://www.gstatic.com/generate_204"
    interval: 300
    tolerance: 100
    lazy: true
  - name: "🔯 故障转移"
    type: fallback
    include-all: true
    filter: "(?i)^(?!.*(官网|官方|网站|網站|客服|邀请|邀請|重置|剩余|剩餘|到期|过期|過期|流量|套餐|订阅|訂閱|续费|續費|客户端|客戶端|🇦🇶|群组|群組|直连|直連|Expire|Traffic|Reset|Website|(?<![A-Za-z])CF(?![A-Za-z])|Cloudflare)).*$"
    url: "https://www.gstatic.com/generate_204"
    interval: 300
    lazy: true
  - name: "🔮 负载均衡"
    type: load-balance
    include-all: true
    filter: "(?i)^(?!.*(官网|官方|网站|網站|客服|邀请|邀請|重置|剩余|剩餘|到期|过期|過期|流量|套餐|订阅|訂閱|续费|續費|客户端|客戶端|🇦🇶|群组|群組|直连|直連|Expire|Traffic|Reset|Website|(?<![A-Za-z])CF(?![A-Za-z])|Cloudflare)).*$"
    url: "https://www.gstatic.com/generate_204"
    interval: 300
    strategy: consistent-hashing
  # 手动挑单个节点用。上面几组都是自动的，没有这一组就只能选组不能选节点。
  - name: "🔧 手动选择"
    type: select
    include-all: true
    filter: "(?i)^(?!.*(官网|官方|网站|網站|客服|邀请|邀請|重置|剩余|剩餘|到期|过期|過期|流量|套餐|订阅|訂閱|续费|續費|客户端|客戶端|🇦🇶|群组|群組|直连|直連|Expire|Traffic|Reset|Website|(?<![A-Za-z])CF(?![A-Za-z])|Cloudflare)).*$"
  # 线路属性、地区、直连线路（地区 × 无中转，判据见文件头 DIRECTS）、自建 CF。
  - name: "🏠 住宅IP"
    type: url-test
    include-all: true
    filter: "(?i)^(?!.*(?:剩余|剩餘|流量|到期|过期|過期|重置|套餐|官网|官網|订阅|訂閱|续费|續費|客户端|客戶端|🇦🇶|Expire|Traffic|Reset))(?=.*(住宅|家宽|家寬|Residential)).*$"
    url: "https://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "🛣️ 专线"
    type: url-test
    include-all: true
    filter: "(?i)^(?!.*(?:剩余|剩餘|流量|到期|过期|過期|重置|套餐|官网|官網|订阅|訂閱|续费|續費|客户端|客戶端|🇦🇶|Expire|Traffic|Reset))(?=.*(专线|專線|IPLC|IEPL)).*$"
    url: "https://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "🎞️ 流媒体节点"
    type: url-test
    include-all: true
    filter: "(?i)^(?!.*(?:剩余|剩餘|流量|到期|过期|過期|重置|套餐|官网|官網|订阅|訂閱|续费|續費|客户端|客戶端|🇦🇶|Expire|Traffic|Reset))(?!.*(俄罗斯|俄羅斯|Russia|越南|Vietnam|马来西亚|馬來西亞|Malaysia|印度|(?<![A-Za-z])India(?![A-Za-z])|印尼|Indonesia|泰国|泰國|Thailand|菲律宾|菲律賓|Philippines))(?=.*(流媒体|流媒體|原生|解锁|解鎖)).*$"
    url: "https://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "💴 低倍率"
    type: url-test
    include-all: true
    filter: "(?i)^(?!.*(?:剩余|剩餘|流量|到期|过期|過期|重置|套餐|官网|官網|订阅|訂閱|续费|續費|客户端|客戶端|🇦🇶|Expire|Traffic|Reset))(?=.*(?<![0-9.])0\\.[0-9]+ ?x).*$"
    url: "https://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "🇭🇰 香港"
    type: url-test
    include-all: true
    filter: "(?i)^(?!.*(?:剩余|剩餘|流量|到期|过期|過期|重置|套餐|官网|官網|订阅|訂閱|续费|續費|客户端|客戶端|🇦🇶|Expire|Traffic|Reset))(?=.*(香港|港岛|深港|沪港|Hong ?Kong|(?<![A-Za-z])(HK|HKG)(?![A-Za-z]))).*$"
    url: "https://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "🇹🇼 台湾"
    type: url-test
    include-all: true
    filter: "(?i)^(?!.*(?:剩余|剩餘|流量|到期|过期|過期|重置|套餐|官网|官網|订阅|訂閱|续费|續費|客户端|客戶端|🇦🇶|Expire|Traffic|Reset))(?=.*(台湾|台灣|台北|臺灣|Taiwan|(?<![A-Za-z])(TW|TPE)(?![A-Za-z]))).*$"
    url: "https://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "🇯🇵 日本"
    type: url-test
    include-all: true
    filter: "(?i)^(?!.*(?:剩余|剩餘|流量|到期|过期|過期|重置|套餐|官网|官網|订阅|訂閱|续费|續費|客户端|客戶端|🇦🇶|Expire|Traffic|Reset))(?=.*(日本|東京|东京|大阪|名古屋|埼玉|Japan|(?<![A-Za-z])(JP|JPN|NRT|KIX)(?![A-Za-z]))).*$"
    url: "https://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "🇸🇬 狮城"
    type: url-test
    include-all: true
    filter: "(?i)^(?!.*(?:剩余|剩餘|流量|到期|过期|過期|重置|套餐|官网|官網|订阅|訂閱|续费|續費|客户端|客戶端|🇦🇶|Expire|Traffic|Reset))(?=.*(新加坡|狮城|獅城|Singapore|(?<![A-Za-z])(SG|SIN)(?![A-Za-z]))).*$"
    url: "https://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "🇺🇲 美国"
    type: url-test
    include-all: true
    filter: "(?i)^(?!.*(?:剩余|剩餘|流量|到期|过期|過期|重置|套餐|官网|官網|订阅|訂閱|续费|續費|客户端|客戶端|🇦🇶|Expire|Traffic|Reset))(?=.*(美国|美國|美西|美东|美東|洛杉矶|圣何塞|西雅图|达拉斯|凤凰城|United ?States|(?<![A-Za-z])(US|USA|LAX|SJC)(?![A-Za-z]))).*$"
    url: "https://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "🇰🇷 韩国"
    type: url-test
    include-all: true
    filter: "(?i)^(?!.*(?:剩余|剩餘|流量|到期|过期|過期|重置|套餐|官网|官網|订阅|訂閱|续费|續費|客户端|客戶端|🇦🇶|Expire|Traffic|Reset))(?=.*(韩国|韓國|首尔|首爾|Korea|(?<![A-Za-z])(KR|ICN)(?![A-Za-z]))).*$"
