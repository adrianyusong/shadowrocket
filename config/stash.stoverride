    filter: "(?i)^(?!.*(?:剩余|剩餘|流量|到期|过期|過期|重置|套餐|官网|官網|订阅|訂閱|续费|續費|客户端|客戶端|🇦🇶|Expire|Traffic|Reset))(?=.*(台湾|台灣|台北|臺灣|Taiwan|(?<![A-Za-z])(TW|TPE)(?![A-Za-z])))(?!.*(?<![A-Za-z])CTCU(?![A-Za-z]))(?!.*(中转|中轉|隧道|转发|轉發)).*$"
    url: "https://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "🇬🇧 英国直连"
    type: url-test
    include-all: true
    filter: "(?i)^(?!.*(?:剩余|剩餘|流量|到期|过期|過期|重置|套餐|官网|官網|订阅|訂閱|续费|續費|客户端|客戶端|🇦🇶|Expire|Traffic|Reset))(?=.*(英国|英國|伦敦|倫敦|London|(?<![A-Za-z])(UK|GB|LHR)(?![A-Za-z])))(?!.*(?<![A-Za-z])CTCU(?![A-Za-z]))(?!.*(中转|中轉|隧道|转发|轉發)).*$"
    url: "https://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "🇰🇷 韩国直连"
    type: url-test
    include-all: true
    filter: "(?i)^(?!.*(?:剩余|剩餘|流量|到期|过期|過期|重置|套餐|官网|官網|订阅|訂閱|续费|續費|客户端|客戶端|🇦🇶|Expire|Traffic|Reset))(?=.*(韩国|韓國|首尔|首爾|Korea|(?<![A-Za-z])(KR|ICN)(?![A-Za-z])))(?!.*(?<![A-Za-z])CTCU(?![A-Za-z]))(?!.*(中转|中轉|隧道|转发|轉發)).*$"
    url: "https://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  - name: "☁️ CF优选"
    type: url-test
    include-all: true
    filter: "(?i)^(?!.*(?:剩余|剩餘|流量|到期|过期|過期|重置|套餐|官网|官網|订阅|訂閱|续费|續費|客户端|客戶端|🇦🇶|Expire|Traffic|Reset))(?=.*((?<![A-Za-z])CF(?![A-Za-z])|Cloudflare)).*$"
    url: "https://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 200
    lazy: true
  # 以下 select 组的候选由 tools/build-stash.py 从 config/default.conf 照抄，
  # Shadowrocket 的 policy-select-name 在这里体现为「排第一」。
  - name: "🚀 节点选择"
